{
  "name": "align-spaces",
  "version": "0.4.0-alpha.1",
  "displayName": "Align Spaces",
  "publisher": "OldStarchy",
  "description": "Align operators without modifying the code",
  "icon": "images/icon.png",
  "repository": {
    "url": "https://github.com/OldStarchy/Align-Spaces"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "align-spaces.toggleCurrentDocument",
        "when": "editorFocus",
        "key": "ctrl+shift+="
      }
    ],
    "commands": [
      {
        "command": "align-spaces.showConfig",
        "category": "Align Spaces",
        "title": "Show Config"
      },
      {
        "command": "align-spaces.toggleCurrentDocument",
        "category": "Align Spaces",
        "title": "Enable/disable for Current Document"
      }
    ],
    "configuration": {
      "title": "Align Spaces",
      "properties": {
        "align-spaces.enabled": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "Whether to automatically realign the document when it is edited."
        },
        "align-spaces.realignDelayMs": {
          "type": "integer",
          "default": 500,
          "description": "The delay in milliseconds before realigning the document after an edit."
        },
        "align-spaces.lineCommentMarkers": {
          "scope": "language-overridable",
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Markers that indicate a line comment to be aligned."
        },
        "align-spaces.assignmentMarkers": {
          "scope": "language-overridable",
          "type": "array",
          "items": {
            "type": "object",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "marker",
                  "mode"
                ],
                "properties": {
                  "marker": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "before",
                      "after"
                    ]
                  },
                  "identifier": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "regex",
                  "mode"
                ],
                "properties": {
                  "regex": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "pattern": {
                            "type": "string"
                          },
                          "flags": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "pattern"
                        ]
                      }
                    ]
                  },
                  "group": {
                    "type": "integer",
                    "description": "The capturing group to use for alignment. Defaults to 0 (the entire match)."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "before",
                      "after"
                    ]
                  },
                  "identifier": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "default": [
            {
              "regex": "([+\\-*/% ]=)[^=]",
              "group": 1,
              "mode": "before",
              "identifier": "assignment"
            }
          ],
          "description": "Markers that indicate an assignment to be aligned."
        },
        "align-spaces.dontAdjustLineRegEx": {
          "scope": "language-overridable",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "flags": {
                  "type": "string"
                }
              },
              "required": [
                "pattern"
              ]
            }
          ]
        },
        "align-spaces.skipLinesRegex": {
          "scope": "language-overridable",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "flags": {
                  "type": "string"
                }
              },
              "required": [
                "pattern"
              ]
            }
          ]
        },
        "align-spaces.recursiveGroupMarkers": {
          "scope": "language-overridable",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          }
        }
      }
    },
    "configurationDefaults": {
      "[javascript]": {
        "align-spaces.lineCommentMarkers": [
          "//"
        ],
        "align-spaces.assignmentMarkers": [
          {
            "regex": "([+\\-*/% ]=)[^=]",
            "group": 1,
            "mode": "before",
            "identifier": "assignment"
          },
          {
            "regex": "[^ ]:(?!\\s*[\\w.]+\\s*=)",
            "mode": "after",
            "identifier": "object-colon"
          },
          {
            "marker": "from",
            "mode": "before"
          }
        ]
      },
      "[typescript]": {
        "align-spaces.lineCommentMarkers": [
          "//"
        ],
        "align-spaces.assignmentMarkers": [
          {
            "regex": "([+\\-*/% ]=)[^=]",
            "group": 1,
            "mode": "before",
            "identifier": "assignment"
          },
          {
            "regex": "[^ ]:(?!\\s*[\\w.]+\\s*=)",
            "mode": "after",
            "identifier": "object-colon"
          },
          {
            "marker": "from",
            "mode": "before"
          }
        ]
      },
      "[bicep]": {
        "align-spaces.lineCommentMarkers": [
          "//"
        ],
        "align-spaces.assignmentMarkers": [
          {
            "regex": "([+\\-*/% ]=)[^=]",
            "group": 1,
            "mode": "before",
            "identifier": "assignment"
          },
          {
            "regex": "[^ ]:(?!.*?=)",
            "mode": "after",
            "identifier": "object-colon"
          },
          {
            "regex": "\\w+\\s+\\S+\\s+(string|int|bool)(\\s*=)?",
            "group": 1,
            "mode": "before",
            "identifier": "param"
          }
        ]
      }
    }
  },
  "scripts": {
    "test": "yarn run test:unit && yarn run test:web",
    "test:unit": "mocha",
    "test:unit:watch": "mocha --watch",
    "test:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest:web": "yarn run compile-web",
    "vscode:prepublish": "yarn run package-web",
    "compile-web": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.106.1",
    "@vscode/test-web": "^0.0.75",
    "assert": "^2.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "glob": "^11.0.3",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
