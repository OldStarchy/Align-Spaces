{
  "name": "align-spaces",
  "version": "0.4.0-alpha.1",
  "displayName": "Align Spaces",
  "publisher": "OldStarchy",
  "description": "Align operators without modifying the code",
  "icon": "images/icon.png",
  "repository": {
    "url": "https://github.com/OldStarchy/Align-Spaces"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "align-spaces.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "test": "yarn run test:unit && yarn run test:web",
    "test:unit": "mocha",
    "test:unit:watch": "mocha --watch",
    "test:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest:web": "yarn run compile-web",
    "vscode:prepublish": "yarn run package-web",
    "compile-web": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.106.1",
    "@vscode/test-web": "^0.0.75",
    "assert": "^2.1.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "glob": "^11.0.3",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
